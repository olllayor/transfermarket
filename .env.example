# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://mongo:27017/ca-football

# JWT
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d

# Default admin user (created on bootstrap if not exists)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345

# Redis (optional)
REDIS_URL=redis://redis:6379
USE_REDIS=false
